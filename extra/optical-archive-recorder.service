[Unit]
Description=Optical Archive optical-recorder
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/optical-archive/optical-archive.env
WorkingDirectory=/opt/burnbridge/optical-recorder
ExecStart=/opt/burnbridge/scripts/optical-archive-start.sh recorder
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
