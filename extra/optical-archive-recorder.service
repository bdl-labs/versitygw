[Unit]
Description=Optical Archive BurnServer
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/optical-archive/optical-archive.env
WorkingDirectory=/opt/burnbridge/burnserver
ExecStart=/opt/burnbridge/scripts/optical-archive-start.sh recorder
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
