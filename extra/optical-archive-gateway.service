[Unit]
Description=Optical Archive Gateway
Wants=network-online.target optical-archive-recorder.service
After=network-online.target optical-archive-recorder.service

[Service]
Type=simple
User=root
EnvironmentFile=-/etc/optical-archive/optical-archive.env
WorkingDirectory=/opt/burnbridge/versitygw
ExecStart=/opt/burnbridge/scripts/optical-archive-start.sh gateway
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
