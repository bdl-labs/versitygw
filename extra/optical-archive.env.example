# Copy to /etc/optical-archive/optical-archive.env on Linux.
# These defaults match the Raspberry Pi deployment layout used by BurnBridge.

OPTICAL_ARCHIVE_HOME=/opt/burnbridge
OPTICAL_ARCHIVE_CONFIG_PATH=/opt/burnbridge/config/optical-archive.config.json
OPTICAL_ARCHIVE_DATA_DIR=/var/lib/burnbridge
OPTICAL_ARCHIVE_LOG_DIR=/var/log/burnbridge
OPTICAL_ARCHIVE_DOTNET_ENV_SCRIPT=/root/configure.sh

OPTICAL_ARCHIVE_MOUNT_PATH=/mnt/optical
OPTICAL_ARCHIVE_MOUNT_DEVICE=/dev/sr0

# optical-recorder reads these through .NET environment configuration.
# They are equivalent to OpticalArchive:LinuxServices:* in optical-archive.config.json.
OpticalArchive__LinuxServices__MountRefreshEnabled=true
OpticalArchive__LinuxServices__MountRefreshServiceType=command
OpticalArchive__LinuxServices__MountRefreshMountPath=/mnt/optical
OpticalArchive__LinuxServices__MountRefreshDevice=/dev/sr0
OpticalArchive__LinuxServices__MountRefreshCommand='/opt/burnbridge/scripts/optical-archive-mount-refresh.sh "{mountPath}" "{device}"'

ASPNETCORE_URLS=http://0.0.0.0:50051

ROOT_ACCESS_KEY_ID=admin
ROOT_SECRET_ACCESS_KEY=admin123456
VGW_REGION=us-east-1
VGW_PORT=:7070
VGW_ADMIN_PORT=:7080
VGW_HEALTH=/health
VGW_IAM_DIR=/var/lib/burnbridge/iam
VGW_WEBUI_PORT=:7071
VGW_WEBUI_NO_TLS=true
VGW_CORS_ALLOW_ORIGIN=*
VGW_WEBUI_GATEWAYS=http://192.168.2.108:7070
VGW_WEBUI_ADMIN_GATEWAYS=http://192.168.2.108:7080

VGW_BURNBRIDGE_DB_PATH=/var/lib/burnbridge/burnbridge-meta.sqlite
VGW_BURNBRIDGE_GRPC_ADDR=127.0.0.1:50051
VGW_BURNBRIDGE_GRPC_DIAL_TIMEOUT=120s
VGW_BURNBRIDGE_GRPC_READY_TIMEOUT=90s
VGW_BURNBRIDGE_GRPC_PING_TIMEOUT=60s
VGW_BURNBRIDGE_GRPC_CHUNK_SIZE=262144
VGW_BURNBRIDGE_PUT_OBJECT_TIMEOUT=8h
